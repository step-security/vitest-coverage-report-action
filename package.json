{
  "name": "@step-security/vitest-coverage-report-action",
  "version": "0.0.0",
  "description": "A GitHub Action to report the test coverage of vitest",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage.enabled true",
    "test:export": "npx ts-node test/exportTestTable.ts",
    "lint": "biome check",
    "lint:write": "biome check --write",
    "lint:ci": "biome ci",
    "build": "rm -rf dist && node esbuild.cjs",
    "start": "npm run build && node dist/index.js",
    "typecheck": "npx tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/vitest-coverage-report-action.git"
  },
  "keywords": [
    "vitest",
    "coverage",
    "nyc"
  ],
  "author": "step-security",
  "publisher": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/vitest-coverage-report-action/issues"
  },
  "homepage": "https://github.com/step-security/vitest-coverage-report-action#readme",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "common-tags": "1.8.2",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/common-tags": "1.8.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
